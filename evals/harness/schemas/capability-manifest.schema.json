{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zivtech.com/wp-meta-skills/schemas/capability-manifest.schema.json",
  "title": "WordPress capability manifest",
  "description": "Machine-readable record of what an agent can actually run in a WordPress environment. LOAD-BEARING RULE: the statuses BLOCKED and UNKNOWN never satisfy a capability requirement. Absence of a failure is not a pass. Any consumer that treats a non-AVAILABLE status as permission to proceed is violating this schema's contract.",
  "$comment": "schema_version 1.1.0: additive, backward-compatible change. Added the top-level runtime_tools section (Lane 1: config/CLI-only detection of agent-facing runtime tool surfaces running alongside the skills -- Studio's built-in `studio mcp`, the `ddev pull/push pressable` path, and the deprecated standalone `studio-mcp`, plus a names-only awareness list of Studio's built-in Agent Skills) and four derived capabilities bound to it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "probe_version",
    "probe_argv",
    "allow_eval",
    "environment",
    "wp_cli",
    "wordpress",
    "abilities",
    "mcp",
    "verification_tools",
    "runtime_tools",
    "capabilities",
    "blockers",
    "evidence"
  ],
  "$defs": {
    "status": {
      "description": "AVAILABLE = probed, works, evidence attached. UNAVAILABLE = probed, definitively absent. BLOCKED = a prerequisite failed so the question could not be asked. UNKNOWN = not probed, or the probe was inconclusive. Only AVAILABLE satisfies a requirement.",
      "type": "string",
      "enum": ["AVAILABLE", "UNAVAILABLE", "BLOCKED", "UNKNOWN"]
    },
    "reason": {
      "type": ["string", "null"],
      "description": "Stable machine-readable reason string, snake_case. Consumers may quote it verbatim to the user."
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "commandState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "toolState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "version": {"type": ["string", "null"]},
        "reason": {"$ref": "#/$defs/reason"},
        "invocation": {
          "type": ["array", "null"],
          "items": {"type": "string"}
        },
        "standards": {
          "type": ["array", "null"],
          "items": {"type": "string"}
        },
        "runtime": {"type": ["string", "null"]},
        "wp_stubs_version": {"type": ["string", "null"]},
        "notes": {"$ref": "#/$defs/notes"}
      }
    },
    "runtimeTool": {
      "description": "A single tool exposed by an agent-facing runtime surface (an MCP server or a host CLI path), classified by its worst-case side effect so a capability consumer can gate on it without inspecting the tool itself.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "side_effect", "confirm_required"],
      "properties": {
        "name": {"type": "string"},
        "side_effect": {
          "description": "Ordered least to most dangerous.",
          "type": "string",
          "enum": [
            "read_only",
            "local_write",
            "read_write_local",
            "provision",
            "inward_sync",
            "outward_sync"
          ]
        },
        "confirm_required": {"type": "boolean"},
        "target_constraint": {"type": "string"}
      }
    },
    "runtimeServer": {
      "description": "One agent-facing runtime tool surface: a built-in or standalone MCP server, or a host CLI path such as `ddev pull/push pressable`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "transport", "trust"],
      "properties": {
        "id": {"type": "string"},
        "kind": {
          "type": "string",
          "enum": [
            "studio-mcp-builtin",
            "studio-mcp-standalone",
            "ddev-pressable",
            "unknown"
          ]
        },
        "identity": {"type": ["string", "null"]},
        "transport": {"type": "string", "enum": ["stdio", "cli"]},
        "invocation": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Redacted argv, like other invocation fields in this manifest. Never a command this probe executed against the surface itself -- see trust."
        },
        "source": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "superseded": {"type": "boolean"},
        "trust": {
          "description": "How this server's presence was established. 'config' = a config/marker file was found. 'cli-help' = a host CLI's --help output named the surface. Never 'tools-list' in this schema version: an MCP tools/list handshake is out of scope for Lane 1.",
          "type": "string",
          "enum": ["config", "cli-help"]
        },
        "tool_count": {"type": ["integer", "null"], "minimum": 0},
        "tools": {
          "type": "array",
          "items": {"$ref": "#/$defs/runtimeTool"}
        },
        "notes": {"$ref": "#/$defs/notes"}
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "description": "UTC RFC 3339 timestamp. A probe is a snapshot, not a subscription: consumers must treat a manifest generated before the current session as stale.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "probe_version": {"type": "string"},
    "probe_argv": {
      "type": "array",
      "items": {"type": "string"}
    },
    "allow_eval": {
      "type": "boolean",
      "description": "True when --allow-eval was passed and `wp eval` was therefore permitted. `wp eval` runs arbitrary PHP in the WordPress context; it is the strongest safety boundary in the WP-CLI surface and is off by default."
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "kind", "invocation_prefix", "cwd", "host"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "kind": {
          "type": "string",
          "enum": [
            "ddev",
            "lando",
            "wp-env",
            "remote-alias",
            "studio",
            "localwp",
            "generic-local",
            "UNKNOWN"
          ]
        },
        "invocation_prefix": {
          "type": ["array", "null"],
          "items": {"type": "string"},
          "description": "Argv prefix that reaches WP-CLI. Null when no prefix was validated by `<prefix> --info`."
        },
        "marker_file": {"type": ["string", "null"]},
        "other_markers_present": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Losing detection candidates. Ambiguity is signal, not noise."
        },
        "wp_env_runtime": {
          "type": ["string", "null"],
          "enum": ["docker", "playground", null]
        },
        "remote_alias": {"type": ["string", "null"]},
        "cwd": {"type": "string"},
        "host": {
          "type": "object",
          "additionalProperties": false,
          "description": "Host facts. Exempt from the evidence-tracing rule.",
          "properties": {
            "os": {"type": ["string", "null"]},
            "php": {"type": ["string", "null"]},
            "node": {"type": ["string", "null"]},
            "composer": {"type": ["string", "null"]}
          }
        }
      }
    },
    "wp_cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "commands"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "version": {"type": ["string", "null"]},
        "reason": {"$ref": "#/$defs/reason"},
        "is_stable_release": {
          "type": ["boolean", "null"],
          "description": "Probed from the reported version string: true when it carries no prerelease suffix, false when it does, null when no version was found. Never derived from equality with a frozen known-stable constant."
        },
        "commands": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Single WP-CLI command roots only. A key drift like 'ability list' must fail validation, not silently convert a gate failure into a warning."
          },
          "additionalProperties": {"$ref": "#/$defs/commandState"}
        },
        "notes": {"$ref": "#/$defs/notes"}
      }
    },
    "wordpress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/reason"},
        "core_version": {"type": ["string", "null"]},
        "php_version": {"type": ["string", "null"]},
        "is_multisite": {"type": ["boolean", "null"]},
        "is_installed": {"type": ["boolean", "null"]},
        "siteurl": {"type": ["string", "null"]},
        "home": {"type": ["string", "null"]},
        "active_plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "activation_state"],
            "properties": {
              "name": {"type": "string"},
              "version": {"type": ["string", "null"]},
              "activation_state": {
                "type": "string",
                "description": "WP-CLI's reported activation state (active/inactive/must-use/dropin) — a free string from `wp plugin list`, deliberately not named `status` so it cannot be confused with the four-value status enum."
              }
            }
          }
        },
        "active_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "activation_state"],
            "properties": {
              "name": {"type": "string"},
              "version": {"type": ["string", "null"]},
              "activation_state": {
                "type": "string",
                "description": "WP-CLI's reported activation state — a free string from `wp theme list`, deliberately not named `status`."
              }
            }
          }
        },
        "notes": {"$ref": "#/$defs/notes"}
      }
    },
    "abilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/reason"},
        "api_present": {"type": ["boolean", "null"]},
        "api_source": {"type": ["string", "null"]},
        "registered_count": {"type": ["integer", "null"], "minimum": 0},
        "registered": {
          "type": "array",
          "items": {"type": "string"}
        },
        "publicly_exposed_count": {"type": ["integer", "null"], "minimum": 0},
        "notes": {"$ref": "#/$defs/notes"}
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/reason"},
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present"],
          "properties": {
            "present": {"type": "boolean"},
            "version": {"type": ["string", "null"]},
            "prerelease": {"type": ["boolean", "null"]}
          }
        },
        "transports": {"type": "array", "items": {"type": "string"}},
        "servers": {"type": "array", "items": {"type": "string"}},
        "tools": {"type": "array", "items": {"type": "string"}},
        "deprecated_detected": {"type": "array", "items": {"type": "string"}},
        "notes": {"$ref": "#/$defs/notes"}
      }
    },
    "verification_tools": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "Snake_case tool identifiers only, so a key drift cannot silently detach a tool from its consumers."
      },
      "additionalProperties": {"$ref": "#/$defs/toolState"}
    },
    "runtime_tools": {
      "description": "Agent-facing runtime tool surfaces running alongside the skills (Studio's built-in `studio mcp`, the `ddev pull/push pressable` path, the deprecated standalone `studio-mcp`), plus a names-only awareness list of Studio's built-in Agent Skills. Detection is config/CLI-only in this schema version: no MCP tools/list handshake, and this probe never executes a runtime tool.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/reason"},
        "detected_via": {
          "type": "string",
          "enum": ["config", "cli-help", "none"]
        },
        "servers": {
          "type": "array",
          "items": {"$ref": "#/$defs/runtimeServer"}
        },
        "agent_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "text_incorporated"],
            "properties": {
              "id": {"type": "string"},
              "source": {"type": "string"},
              "text_incorporated": {
                "type": "boolean",
                "description": "Always false: this is a names-only awareness list. The probe never reads a listed skill's contents."
              }
            }
          }
        },
        "deprecated_detected": {"type": "array", "items": {"type": "string"}},
        "notes": {"$ref": "#/$defs/notes"}
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Every value is derived strictly from an AVAILABLE status. A BLOCKED or UNKNOWN input yields false, never true.",
      "additionalProperties": false,
      "required": [
        "can_run_wp_cli",
        "can_read_site_state",
        "can_run_static_analysis",
        "can_run_plugin_check",
        "can_provision_ephemeral_site",
        "can_reach_mcp_abilities",
        "can_register_abilities",
        "can_handoff_runtime_wp_cli",
        "can_provision_runtime_site",
        "has_outward_sync_tool",
        "aware_of_host_agent_skills"
      ],
      "properties": {
        "can_run_wp_cli": {"type": "boolean"},
        "can_read_site_state": {"type": "boolean"},
        "can_run_static_analysis": {"type": "boolean"},
        "can_run_plugin_check": {"type": "boolean"},
        "can_provision_ephemeral_site": {"type": "boolean"},
        "can_reach_mcp_abilities": {"type": "boolean"},
        "can_register_abilities": {"type": "boolean"},
        "can_handoff_runtime_wp_cli": {
          "type": "boolean",
          "description": "True only when runtime_tools is AVAILABLE and carries a wp_cli/read_write_local-class tool."
        },
        "can_provision_runtime_site": {
          "type": "boolean",
          "description": "True only when runtime_tools is AVAILABLE and carries a provision-class tool."
        },
        "has_outward_sync_tool": {
          "type": "boolean",
          "description": "True only when runtime_tools is AVAILABLE and carries an outward_sync-class tool."
        },
        "aware_of_host_agent_skills": {
          "type": "boolean",
          "description": "True only when runtime_tools is AVAILABLE and agent_skills is non-empty."
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "affects", "detail"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"type": "string", "enum": ["CRITICAL", "MAJOR", "MINOR"]},
          "affects": {"type": "array", "items": {"type": "string"}},
          "detail": {"type": "string"},
          "remediation_hint": {"type": ["string", "null"]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Every probed fact traces here by claim path. stdout_excerpt is truncated to 2000 characters and redacted; raw bytes are never persisted. This is a manifest, not a log.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "argv", "exit_code"],
        "properties": {
          "claim": {"type": "string"},
          "argv": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": ["integer", "null"]},
          "stdout_excerpt": {"type": ["string", "null"], "maxLength": 2000},
          "stderr_excerpt": {"type": ["string", "null"], "maxLength": 2000},
          "duration_ms": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "The load-bearing rule, machine-checked where it is expressible: a capability may only be true when the section it derives from is AVAILABLE. BLOCKED and UNKNOWN never satisfy a capability.",
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["can_run_wp_cli"],
            "properties": {"can_run_wp_cli": {"const": true}}
          }
        }
      },
      "then": {
        "required": ["wp_cli"],
        "properties": {"wp_cli": {"properties": {"status": {"const": "AVAILABLE"}}}}
      }
    },
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["can_read_site_state"],
            "properties": {"can_read_site_state": {"const": true}}
          }
        }
      },
      "then": {
        "required": ["wordpress"],
        "properties": {"wordpress": {"properties": {"status": {"const": "AVAILABLE"}}}}
      }
    },
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["can_reach_mcp_abilities"],
            "properties": {"can_reach_mcp_abilities": {"const": true}}
          }
        }
      },
      "then": {
        "required": ["mcp"],
        "properties": {"mcp": {"properties": {"status": {"const": "AVAILABLE"}}}}
      }
    },
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["can_register_abilities"],
            "properties": {"can_register_abilities": {"const": true}}
          }
        }
      },
      "then": {
        "required": ["abilities"],
        "properties": {"abilities": {"properties": {"status": {"const": "AVAILABLE"}}}}
      }
    },
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["can_handoff_runtime_wp_cli"],
            "properties": {"can_handoff_runtime_wp_cli": {"const": true}}
          }
        }
      },
      "then": {
        "required": ["runtime_tools"],
        "properties": {"runtime_tools": {"properties": {"status": {"const": "AVAILABLE"}}}}
      }
    },
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["can_provision_runtime_site"],
            "properties": {"can_provision_runtime_site": {"const": true}}
          }
        }
      },
      "then": {
        "required": ["runtime_tools"],
        "properties": {"runtime_tools": {"properties": {"status": {"const": "AVAILABLE"}}}}
      }
    },
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["has_outward_sync_tool"],
            "properties": {"has_outward_sync_tool": {"const": true}}
          }
        }
      },
      "then": {
        "required": ["runtime_tools"],
        "properties": {"runtime_tools": {"properties": {"status": {"const": "AVAILABLE"}}}}
      }
    },
    {
      "if": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["aware_of_host_agent_skills"],
            "properties": {"aware_of_host_agent_skills": {"const": true}}
          }
        }
      },
      "then": {
        "required": ["runtime_tools"],
        "properties": {"runtime_tools": {"properties": {"status": {"const": "AVAILABLE"}}}}
      }
    }
  ]
}
